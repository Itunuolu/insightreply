# InsightReply backend — environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required: your OpenAI API key. Kept server-side only. Never exposed to the extension.
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API. Defaults to OpenAI; point to a proxy/router when used.
OPENAI_BASE_URL=https://api.openai.com/v1

# Transport used for structured generation: 'responses' (OpenAI Responses API) or 'chat' (chat completions).
OPENAI_TRANSPORT=responses

# Structured-output format for chat transport: 'json_schema' (official OpenAI) or
# 'json_object' (supported by DeepSeek; the JSON schema is inlined into the prompt).
OPENAI_RESPONSE_FORMAT=json_schema

# Model used for comment generation (must support the Responses API).
OPENAI_MODEL=gpt-5

# Port the Fastify server listens on.
PORT=8787

# Origin allowed to call the API directly from a browser context.
# Use the Chrome extension id origin, e.g. chrome-extension://<your-extension-id>
# Leave empty to allow only same-origin / non-browser clients (curl, Node).
ALLOWED_EXTENSION_ORIGIN=

# Rate limiting (per IP).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000

# Optional: set true if the server runs behind a trusted reverse proxy (enables X-Forwarded-For IPs).
TRUST_PROXY=false

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info